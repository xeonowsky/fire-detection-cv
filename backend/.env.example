DATA_DIR=/data
DATABASE_URL=sqlite:////data/app.db
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
# demo = przykładowy wynik bez modelu, model = Grounding DINO (pierwsza analiza pobiera model ~700 MB)
ANALYSIS_ENGINE=model
ANALYSIS_MAX_FRAMES=120
# Pokrycie kadru: boxes = z ramek (szybko), sam2 = z masek SAM 2 jak w research/grounded_sam (wolniej na CPU)
FIRE_DETECTOR_SEGMENTATION=boxes
DEMO_ANALYSIS_SECONDS=20
