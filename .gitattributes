# Jednolite końce linii (LF) niezależnie od systemu — koniec z fałszywymi zmianami przy Windows/Linux.
* text=auto eol=lf

# Skrypty Windows muszą mieć CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Pliki binarne: bez konwersji i bez diffów tekstowych.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.avi binary
*.mp4 binary
*.mov binary
*.pt binary
*.onnx binary
